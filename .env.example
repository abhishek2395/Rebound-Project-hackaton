# Rebound Multi-App Agent Environment Variables
# Copy to .env and fill in your keys

# Duffel API (Use test mode: starts with duffel_test_)
DUFFEL_API_KEY=duffel_test_your_key_here

# Anthropic / Model Provider
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
TRAVELER_PHONE=+15550000001

# Google Workspace (OAuth2 paths)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Agent Policy Controls
DRY_RUN=false
SPEND_CEILING_USD=800.0
APPROVAL_THRESHOLD_USD=300.0

