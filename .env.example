# Rebound Multi-App Agent Environment Variables
# Copy to .env and fill in your keys

# Each integration below runs live only when its own credentials are set here.
# Anything left blank falls back to the recording fake, so the eval suite and CI
# stay fully offline. Set only what you want live.

# Duffel API (test mode: key starts with duffel_test_)
DUFFEL_API_KEY=duffel_test_your_key_here

# Twilio — all three required before any real message is sent.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Channel: "sms" (default) or "whatsapp". WhatsApp routes through Twilio's
# sandbox and avoids US toll-free/10DLC registration and India DLT filtering,
# both of which block trial-account SMS. For the sandbox, set
# TWILIO_FROM_NUMBER=+14155238886 and join it from each recipient handset.
TWILIO_CHANNEL=sms

# Override the profile's phone numbers so live SMS reaches real, Twilio-verified
# handsets without editing profiles/alex.json. On a Twilio trial, every number
# here must be verified in the console first.
TRAVELER_PHONE=+15550000001
PICKUP_PHONE=+15550000002

# Google Workspace (OAuth2 paths)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Agent Policy Controls
DRY_RUN=false
SPEND_CEILING_USD=800.0
APPROVAL_THRESHOLD_USD=300.0

